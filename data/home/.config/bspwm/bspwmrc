#!/usr/bin/env bash

#exec > /var/log/bspwmrc.log

SUDO_CMD=$(command -v doas || command -v sudo)

#${SUDO_CMD} modprobe -r v4l2loopback
${SUDO_CMD} modprobe v4l2loopback exclusive_caps=1 card_label='OBS Virtual Camera'
${SUDO_CMD} modprobe vmmon
${SUDO_CMD} modprobe vmnet
${SUDO_CMD} modprobe vmw_vmci

export XDG_CURRENT_DESKTOP="XFCE"
export XDG_SESSION_DESKTOP="xfce"
export XDG_SESSION_TYPE="x11"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    ${SUDO_CMD} mkdir -p "$XDG_RUNTIME_DIR"
    ${SUDO_CMD} chown $(id -u):$(id -g) "$XDG_RUNTIME_DIR"
    ${SUDO_CMD} chmod 700 "$XDG_RUNTIME_DIR"
fi

export PATH="${PATH}:${HOME}/.local/bin"

export QT_QPA_PLATFORMTHEME="qt5ct"

export ADW_DISABLE_PORTAL=1

#pgrep -x sxhkd > /dev/null || sxhkd &

sxhkd &

#bspc monitor -d I II III IV V VI VII VIII IX X

#bspc monitor eDP-1-1 -d I II III IV V
#bspc monitor HDMI-0 -d VI VII VIII IX X

bspc monitor eDP-1-1 -d I II III IV V VI VII VIII IX X
bspc monitor HDMI-0 -d I II III IV V VI VII VIII IX X

bspc config border_width         1
bspc config window_gap           0

bspc config remove_disabled_monitors   true
bspc config merge_overlapping_monitors true
bspc config borderless_monocle         true
bspc config gapless_monocle            true
bspc config borderless_singleton       true
bspc config single_monocle             true
bspc config focus_follows_pointer      true
bspc config pointer_follows_focus      false
bspc config pointer_action1            move
bspc config pointer_action3            resize_corner
bspc config split_ratio                0.5

#bspc rule -a Gimp desktop='^8' state=floating follow=on
#bspc rule -a Chromium desktop='^2'
#bspc rule -a mplayer2 state=floating
#bspc rule -a Kupfer.py focus=on
#bspc rule -a Screenkey manage=off

# This line is CRITICAL on Artix to ensure D-Bus session variables are updated
dbus-update-activation-environment --all

xset r rate 250 30

# disable sleep
xset s off -dpms

# set cursor and others
xrdb -merge ~/.Xresources
xsetroot -cursor_name left_ptr

# set gtk3/4 themes
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.desktop.interface gtk-theme "Flat-Remix-GTK-Blue-Darkest"
gsettings set org.gnome.desktop.interface icon-theme "Flat-Remix-Blue-Dark"

lxqt-policykit-agent &

${SUDO_CMD} chronyd -q &

${SUDO_CMD} light -S 15

fastcompmgr &

# set wallpaper
xwallpaper --zoom "/usr/share/backgrounds/ArchLinux_Synthwave_4K_Wallpaper.png"

# notifications
dunst &
sh "/opt/tuf-fan-boost-notification/FanNotifications.sh" &

# statusbar
~/.config/bspwm/bar.sh &
bspc config top_padding 16
xdotool search --sync --classname lemonbar windowstate --add BELOW
stalonetray &
xdotool windowstate $(xdotool search --sync --classname stalonetray) ABOVE
xdotool windowunmap $(xdotool search --sync --classname stalonetray)
nm-applet &
pasystray &
#clipcatd -c ~/.config/clipcat/clipcatd.toml
copyq &

pipewire &

thunar --daemon

${SUDO_CMD} vmware-networks --start

